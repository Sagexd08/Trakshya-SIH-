# Copy this file to .env.local and fill in your values
# In Vercel, set these in Project Settings → Environment Variables

# Public (exposed in browser)
# Mapbox access token
NEXT_PUBLIC_MAPBOX_TOKEN=

# Optional public configs (leave empty to use built-ins)
# Public site URL (used for canonical URLs/metadata); defaults to https://trakshya-sih.vercel.app
NEXT_PUBLIC_SITE_URL=
# External URLs for tracks/stations GeoJSON (if you host your own)
NEXT_PUBLIC_TRACKS_GEOJSON_URL=
NEXT_PUBLIC_STATIONS_GEOJSON_URL=
# Default active corridor filter (e.g., "Delhi-Mumbai")
NEXT_PUBLIC_ACTIVE_CORRIDOR=
# Optional external API base for legacy backend
NEXT_PUBLIC_API_BASE=

# Server-only (never exposed to the browser)
# RapidAPI key for IRCTC live data proxy endpoints
IRCTC_RAPIDAPI_KEY=

# Google Gemini AI API key for AI assistant and decision support
GOOGLE_GEMINI_API_KEY=

# Sentry DSN for error tracking and performance monitoring
SENTRY_DSN=

# Clerk (Auth)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supabase configuration
# Public (browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
